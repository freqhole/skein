{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "skein",
  "version": "0.1.14",
  "identifier": "net.freqhole.skein",
  "build": {
    "beforeDevCommand": {
      "cwd": "../loam",
      "script": "npm run dev:tauri"
    },
    "devUrl": "http://localhost:5891",
    "beforeBuildCommand": {
      "cwd": "../loam",
      "script": "npm run build:tauri"
    },
    "frontendDist": "../loam/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}